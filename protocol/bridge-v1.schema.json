{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KK Hermes Bridge v1 client RPC",
  "$defs": {
    "Hello": {
      "additionalProperties": false,
      "properties": {
        "apiVersion": {
          "const": 1,
          "title": "Apiversion",
          "type": "integer"
        },
        "clientVersion": {
          "maxLength": 64,
          "title": "Clientversion",
          "type": "string"
        },
        "deviceId": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Deviceid",
          "type": "string"
        },
        "profileId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profileid"
        }
      },
      "required": [
        "apiVersion",
        "clientVersion",
        "deviceId"
      ],
      "title": "Hello",
      "type": "object"
    },
    "Ping": {
      "additionalProperties": false,
      "properties": {
        "nonce": {
          "maxLength": 128,
          "title": "Nonce",
          "type": "string"
        }
      },
      "required": [
        "nonce"
      ],
      "title": "Ping",
      "type": "object"
    },
    "ListSessions": {
      "additionalProperties": false,
      "properties": {
        "query": {
          "default": "",
          "maxLength": 500,
          "title": "Query",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        }
      },
      "title": "ListSessions",
      "type": "object"
    },
    "Operation": {
      "additionalProperties": false,
      "properties": {
        "operationId": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Operationid",
          "type": "string"
        }
      },
      "required": [
        "operationId"
      ],
      "title": "Operation",
      "type": "object"
    },
    "Cursor": {
      "additionalProperties": false,
      "properties": {
        "replayEpoch": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Replayepoch",
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        }
      },
      "required": [
        "replayEpoch",
        "sequence"
      ],
      "title": "Cursor",
      "type": "object"
    },
    "OpenSession": {
      "additionalProperties": false,
      "properties": {
        "logicalSessionId": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Logicalsessionid",
          "type": "string"
        },
        "cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cursor"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "logicalSessionId"
      ],
      "title": "OpenSession",
      "type": "object"
    },
    "History": {
      "additionalProperties": false,
      "properties": {
        "logicalSessionId": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Logicalsessionid",
          "type": "string"
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cursor"
        },
        "limit": {
          "default": 100,
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
      },
      "required": [
        "logicalSessionId"
      ],
      "title": "History",
      "type": "object"
    },
    "Session": {
      "additionalProperties": false,
      "properties": {
        "logicalSessionId": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Logicalsessionid",
          "type": "string"
        }
      },
      "required": [
        "logicalSessionId"
      ],
      "title": "Session",
      "type": "object"
    },
    "Fork": {
      "additionalProperties": false,
      "properties": {
        "logicalSessionId": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Logicalsessionid",
          "type": "string"
        },
        "operationId": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Operationid",
          "type": "string"
        }
      },
      "required": [
        "logicalSessionId",
        "operationId"
      ],
      "title": "Fork",
      "type": "object"
    },
    "Send": {
      "additionalProperties": false,
      "properties": {
        "logicalSessionId": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Logicalsessionid",
          "type": "string"
        },
        "operationId": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Operationid",
          "type": "string"
        },
        "text": {
          "maxLength": 65536,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "logicalSessionId",
        "operationId",
        "text"
      ],
      "title": "Send",
      "type": "object"
    },
    "JsonValue": {},
    "Respond": {
      "additionalProperties": false,
      "properties": {
        "logicalSessionId": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Logicalsessionid",
          "type": "string"
        },
        "requestId": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Requestid",
          "type": "string"
        },
        "generation": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generation"
        },
        "answer": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Answer",
          "type": "object"
        }
      },
      "required": [
        "logicalSessionId",
        "requestId",
        "answer"
      ],
      "title": "Respond",
      "type": "object"
    },
    "ModelChange": {
      "additionalProperties": false,
      "properties": {
        "logicalSessionId": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Logicalsessionid",
          "type": "string"
        },
        "requestId": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Requestid",
          "type": "string"
        },
        "expectedRevision": {
          "minimum": 0,
          "title": "Expectedrevision",
          "type": "integer"
        },
        "expectedGeneration": {
          "minimum": 0,
          "title": "Expectedgeneration",
          "type": "integer"
        },
        "model": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "confirm": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confirm"
        }
      },
      "required": [
        "logicalSessionId",
        "requestId",
        "expectedRevision",
        "expectedGeneration",
        "model",
        "provider"
      ],
      "title": "ModelChange",
      "type": "object"
    },
    "ReasoningChange": {
      "additionalProperties": false,
      "properties": {
        "logicalSessionId": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Logicalsessionid",
          "type": "string"
        },
        "requestId": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Requestid",
          "type": "string"
        },
        "expectedRevision": {
          "minimum": 0,
          "title": "Expectedrevision",
          "type": "integer"
        },
        "expectedGeneration": {
          "minimum": 0,
          "title": "Expectedgeneration",
          "type": "integer"
        },
        "effort": {
          "enum": [
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "ultra"
          ],
          "title": "Effort",
          "type": "string"
        }
      },
      "required": [
        "logicalSessionId",
        "requestId",
        "expectedRevision",
        "expectedGeneration",
        "effort"
      ],
      "title": "ReasoningChange",
      "type": "object"
    }
