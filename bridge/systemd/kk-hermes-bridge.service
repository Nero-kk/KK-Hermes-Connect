[Unit]
Description=KK Hermes Connect fixed-profile bridge
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/mnt/d/jin/obsidian/obsidian_remote/zero/.obsidian/plugins/KK-Hermes-Connect/bridge
ExecStart=/home/nero/.local/share/kk-hermes-connect/venv/bin/kk-hermes-bridge serve
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
