[Unit]
Description=KK Hermes Connect fixed-profile bridge
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/kk-hermes-connect/bridge
ExecStart=%h/.local/share/kk-hermes-connect/venv/bin/kk-hermes-bridge serve
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
